rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Deny all direct client access by default.
    //
    // All patient files, diagnostics, prescriptions and clinic documents are
    // read and written exclusively through the server (Firebase Admin SDK /
    // server-issued signed URLs), where tenant, role and patient ownership are
    // enforced. The Admin SDK bypasses these rules, so denying client access
    // here does not affect the application.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Clinic logos and branding: public read, no direct client writes.
    match /public/clinics/{clinicId}/logo {
      allow read: if true;
      allow write: if false;
    }
  }
}
