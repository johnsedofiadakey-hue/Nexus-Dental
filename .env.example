DATABASE_URL="postgres://postgres:postgres@localhost:5432/nexusdental"
JWT_SECRET="your_jwt_secret_key_change_me_in_production"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Deployment (one isolated deployment per clinic) ──────────
# Required. The only supported mode. In production the server REFUSES TO START
# when required configuration is missing or invalid (see docs/CLINIC_PROVISIONING.md,
# and run `npm run config:check` to see what is missing — it prints names, never values).
DEPLOYMENT_MODE="single_clinic"

# The clinic's id. It is chosen in the clinic manifest (clients/<clinic>/clinic.yaml,
# `clinic.id`), becomes the database primary key when you run `npm run clinic:provision`,
# and MUST be identical here. Lowercase letters, digits and hyphens, 3-64 characters.
CLINIC_ID="your-clinic-id-from-manifest"

# Comma-separated optional features for THIS clinic: paystack,hubtel,resend,telehealth
# Each enabled feature makes its secrets (below) mandatory. Must match the manifest's `features`.
ENABLED_FEATURES="paystack,hubtel,resend"

# ─── Redis (BullMQ Queues — Appointment Reminders, Notifications) ────────────
# Required for background job processing (appointment reminders, recall SMS, etc.)
# Local dev: redis://localhost:6379
# Production: Use Redis Cloud, Upstash, or Railway Redis
REDIS_URL="redis://localhost:6379"

# ─── Google OAuth (Staff Sign-In) ─────────────────────────────
# 1. Go to https://console.cloud.google.com → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add your domain to "Authorized JavaScript origins"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ─── Paystack ─────────────────────────────────────────────────
# Get these from https://dashboard.paystack.com → Settings → API Keys
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"

# ─── Email (Staff Invitations) ────────────────────────────────
# Uses Resend (https://resend.com) — free tier: 100 emails/day
# If not set, invite links are printed to the server console (dev mode)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Nexus Dental <noreply@yourdomain.com>"

# ─── Firebase (Patient File Uploads — optional) ───────────────
# Only needed if using Firebase Storage for X-ray / photo uploads
# Get from Firebase console → Project Settings → General
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"

# ─── Hubtel SMS + WhatsApp ─────────────────────────────────────
# Get from https://developers.hubtel.com → API Keys
# Used for patient OTP login, appointment reminders, and recall messages
HUBTEL_CLIENT_ID="your-hubtel-client-id"
HUBTEL_CLIENT_SECRET="your-hubtel-client-secret"
HUBTEL_SENDER_ID="NexusDental"
HUBTEL_WHATSAPP_NUMBER="+233XXXXXXXXX"

# ─── Telehealth (only when ENABLED_FEATURES includes telehealth) ──
DAILY_API_KEY=""

# ─── Backups (.github/workflows/backup.yml, scripts/run-backup.js) ────────────
# BACKUP_WEBHOOK_SECRET: shared secret between the GitHub Actions backup job and
#   this app's POST /api/system/backups/complete callback. Generate with:
#   openssl rand -hex 32 — set the same value here, in Cloud Secret Manager
#   (BACKUP_WEBHOOK_SECRET), and as a GitHub repo secret.
# GITHUB_ACTIONS_TOKEN / GITHUB_REPO: optional, only needed for the "run backup
#   now" manual dispatch button. A GitHub PAT with `actions:write` on this repo.
BACKUP_WEBHOOK_SECRET="generate-with-openssl-rand-hex-32"
GITHUB_ACTIONS_TOKEN=""
GITHUB_REPO="johnsedofiadakey-hue/Nexus-Dental"

# ─── Sentry (error tracking) ────────────────────────────────────
# Create a Next.js project at https://sentry.io → Settings → Projects.
# NEXT_PUBLIC_SENTRY_DSN / SENTRY_DSN: same DSN value in both — public one
#   is for the browser bundle, server one for API routes/instrumentation.ts.
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN: optional, only needed to
#   upload source maps during build so stack traces aren't minified.
#   Auth token: Sentry → Settings → Auth Tokens (needs project:releases scope).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# ─── Backups, restore drills and alerts (Packet C3) ──────────────
# Used by the nightly backup job and the worker. Never put the age PRIVATE key anywhere in this file.
# BACKUP_AGE_RECIPIENT=age1...            # public key(s); the private key stays offline with the owner
# BACKUP_BUCKET=                          # bucket in a SEPARATE project from the app
# BACKUP_GCS_SERVICE_ACCOUNT=             # that project's WRITE-ONLY service account JSON (CI secret)
# BACKUP_LOCAL_DIR=                       # local rehearsal only: store backups in this folder instead
ALERT_EMAIL_TO=""                         # comma-separated addresses told when a backup or worker fails
# OPS_WATCHDOG_SECRET=                    # dedicated random value (openssl rand -hex 32) for POST /api/system/watchdog; NOT the backup secret
# WORKER_HEALTH_PORT=8081                 # worker process health endpoint (/healthz, /readyz)

# ─── SMS reminders and demonstration mode (live-demo packet) ──────
# SMS goes through one provider-neutral service. Hubtel stays for payments/WhatsApp only and is never an SMS fallback.
# SMS_PROVIDER=mnotify                   # mnotify (production) | console (development only: logs, sends nothing)
# MNOTIFY_API_KEY=                       # SECRET: store in Secret Manager, never in a file in git or in chat
# MNOTIFY_SENDER_ID=                     # your approved sender ID, 1-11 letters/digits
# ENABLED_FEATURES must then include "mnotify"
# DEMO_MODE=true                         # demonstration instance only: SMS may ONLY go to DEMO_SMS_ALLOWLIST
# DEMO_SMS_ALLOWLIST=+233200000000       # comma-separated E.164 numbers (required while DEMO_MODE=true)
# DEMO_PATIENT_PHONE=0200000000          # a phone YOU control: the demo patient's number (must be on the allowlist)
